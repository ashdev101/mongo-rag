# OpenAI Configuration
OPENAI_API_KEY="Your-OpenAI-API-Key-Here"

# MongoDB Configuration
MONGODB_URI='Your-MongoDB-URI-Here'
# or MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE='Your-Database-Name-Here'

# Collection Name Mappings (optional - override default mappings)
# COLLECTION_EMPLOYEES=your_employees_collection
# COLLECTION_PERFORMANCE=your_performance_collection
# COLLECTION_ATTENDANCE=your_attendance_collection
# COLLECTION_PROJECTS=your_projects_collection
# COLLECTION_TRAININGS=your_trainings_collection

# AWS Configuration for Claude Bedrock (for CQA system)
AWS_REGION=ap-south-1
# Make sure AWS credentials are configured via:
# - AWS CLI: aws configure
# - Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# - IAM role (if running on EC2)

# Database name (for CQA system)
DB_NAME=hr-cleaned

# Claude Model (optional - defaults to Claude Sonnet 4.5)
# Cross-region models (global.* prefix - work in ap-south-1):
# - global.anthropic.claude-sonnet-4-5-20250929-v1:0 (recommended - current team standard)
# - global.anthropic.claude-opus-4-5-20251101-v1:0
# Regional models (anthropic.* prefix - us-east-1/us-west-2 only):
# - anthropic.claude-3-sonnet-20240229-v1:0
# - anthropic.claude-3-5-sonnet-20240620-v1:0
CLAUDE_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Azure AD Configuration
TEAMS_APP_TENANT_ID="Your-Tenant-ID-Here"
AAD_APP_CLIENT_ID="Your-Client-ID-Here"
APP_ID_URI="Your-App-ID-URI-Here"

# Server Configuration
HOST=localhost
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://localhost:53000,http://localhost:53000,http://localhost:3000,https://sharepointsite.com
